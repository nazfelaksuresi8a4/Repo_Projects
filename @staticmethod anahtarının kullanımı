class MyClass:
    def __init__(self,x):
        self.value = x
    
    def calculate(self):            
        return self.value * 2
    
    @staticmethod
    def calculate_2(x,y):
        return x * y
    
a = MyClass(4)

print(a.calculate_2(12,12))

